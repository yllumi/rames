# ============================================================
# Rames — Environment (salin ke .env lalu sesuaikan)
# ============================================================

# Domain dasar; app bernama {name} otomatis dapat subdomain {name}.{APP_DOMAIN}
APP_DOMAIN=example.com

# Port akses dashboard dari luar (di-map ke 8787 di dalam container)
APP_PORT=8000

# Secret untuk session (GANTI dengan nilai acak yang kuat)
SESSION_SECRET=change-me

# Rentang port host yang boleh dipakai untuk container app
PORT_RANGE_START=30000
PORT_RANGE_END=30999

# Direktori hasil clone tiap app. Default: {proyek}/apps
# (di dalam container akan otomatis /app/apps)
# APPS_PATH=/app/apps

# Direktori config Nginx di host yang di-mount ke dashboard container
NGINX_CONF_PATH=/etc/nginx/sites-available
NGINX_ENABLED_PATH=/etc/nginx/sites-enabled

# File status reload yang ditulis watcher di host, dibaca dashboard
# Default: {proyek}/nginx-status/last-reload.json
# NGINX_RELOAD_STATUS_FILE=/app/nginx-status/last-reload.json

# Reload nginx host dari dashboard (helper container chroot ke root host).
# Config utama, binary, dan image helper (cukup sh+chroot).
# NGINX_HTTP_CONF=/etc/nginx/nginx.conf
# NGINX_BIN=/usr/sbin/nginx
# NGINX_RELOAD_IMAGE=alpine

# Email admin untuk SSL Let's Encrypt (wajib untuk penerbitan sertifikat)
ADMIN_EMAIL=admin@example.com

# SSL otomatis Let's Encrypt (SPECS §8a)
# Mode challenge: http (default; semua DNS provider, butuh port 80 publik) atau
# dns-cloudflare (untuk saat record Cloudflare proxy aktif)
SSL_CHALLENGE=http
# CA endpoint: production | staging (staging untuk uji, hindari rate limit)
SSL_CA_SERVER=production
# Webroot HTTP-01 challenge (dilayani nginx host). Default: {proyek}/webroot
# SSL_WEBROOT=/app/webroot
# File kredensial DNS Cloudflare (wajib saat SSL_CHALLENGE=dns-cloudflare).
# Isi: dns_cloudflare_api_token = <token>; file harus terbaca container dashboard
# CLOUDFLARE_CREDS=/app/secrets/cloudflare.ini

# Direktori sertifikat Let's Encrypt (di-mount dari host ke container & dibaca nginx host)
# LETSENCRYPT_PATH=/etc/letsencrypt

# Socket Docker Engine (Phase 1: di-mount ke container dashboard)
DOCKER_SOCKET=/var/run/docker.sock

# Monitoring resource (SPECS §8d)
# Path /proc host untuk metrik VM. Di dalam container, /proc sudah menampilkan
# nilai host, jadi umumnya TIDAK perlu diubah. Isi hanya bila host memakai lxcfs
# dan Anda menyediakan mount host eksplisit (mis. /host/proc).
# HOST_PROC_PATH=/proc
# Timeout satu siklus pengambilan stats container (detik)
# MONITOR_STATS_TIMEOUT=20
# Interval polling metrik host di halaman /monitor (milidetik; 0 = tanpa polling).
# Hanya membaca /proc sehingga 5-10 detik tetap ringan; tabel container tetap
# diperbarui lewat tombol Refresh.
# MONITOR_POLL_MS=7000

# Timeout (detik) untuk operasi docker compose
DEPLOY_TIMEOUT=600

# Terminal container (docker exec) — lihat ARCHITECTURE.md §5.9
# Binary pembungkus PTY (util-linux `script`) untuk sesi interaktif.
# TERMINAL_SCRIPT_BIN=script
# Timeout perintah one-shot `docker exec` (detik).
# TERMINAL_RUN_TIMEOUT=120
# Umur maksimum sesi terminal (detik) yang masih dianggap layak di-prune.
# TERMINAL_SESSION_TTL=3600
# Sesi tanpa klien/aktivitas (browser ditutup tanpa POST /close) dibuang setelah ini.
# TERMINAL_IDLE_TIMEOUT=900
# Batas jumlah sesi terminal aktif serentak.
# TERMINAL_MAX_SESSIONS=20

# Direktori deploy key SSH per app (opsional; default: {proyek}/database/keys)
# SSH_KEYS_PATH=/app/database/keys
# File known_hosts untuk verifikasi host SSH saat git clone/pull (opsional)
# GIT_KNOWN_HOSTS=/app/database/keys/known_hosts

#DNS_1=8.8.8.8
#DNS_2=1.1.1.1
